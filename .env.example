APP_NAME="Campus Coin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campus_coin
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI (Phases 8–9 + AI-1) — server-side only. Never expose keys to Vite.
AI_ENABLED=true
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=8
AI_RATE_LIMIT_PER_MINUTE=20
AI_CSV_BATCH_SIZE=20
AI_INSIGHT_RATE_LIMIT_PER_MINUTE=5
AI_ASSISTANT_RATE_LIMIT_PER_MINUTE=10
AI_ASSISTANT_MAX_MESSAGE_LENGTH=500

# Google Gemini (AI-1 / AI-1B) — Campus Coin AI assistant activates when GEMINI_API_KEY is set.
# Model locked to gemini-3.5-flash. Official transport: v1beta + x-goog-api-key header.
# Categorization/insights still follow AI_PROVIDER (openai or gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_VERSION=v1beta
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Smart Scan — local Tesseract OCR fallback when Gemini is unavailable (server-side only).
DOCUMENT_SCAN_FAKE=false
DOCUMENT_SCAN_FALLBACK_ENABLED=true
DOCUMENT_SCAN_TESSERACT_BINARY=tesseract
DOCUMENT_SCAN_TESSERACT_TIMEOUT=20
DOCUMENT_SCAN_TESSERACT_LANG=eng

# System intelligence (Phase 10) — deterministic; no AI key required
INTELLIGENCE_ACTIVITY_LIMIT=10
INTELLIGENCE_FORECAST_LOOKBACK_MONTHS=3
INTELLIGENCE_FORECAST_CATEGORY_LIMIT=5
INTELLIGENCE_LARGE_MIN_OBSERVATIONS=5
INTELLIGENCE_LARGE_MULTIPLIER=2.5
INTELLIGENCE_LARGE_ABSOLUTE_FLOOR=500
INTELLIGENCE_DUPLICATE_DATE_WINDOW_DAYS=0
